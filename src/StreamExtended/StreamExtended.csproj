<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>StrongKey.snk</AssemblyOriginatorKeyFile>
    <VersionPrefix>2.0.2</VersionPrefix>
    <Authors>justcoding121</Authors>
    <Description>Peek TLS ClientHello/ServerHello (SNI, ALPN, extensions) from a stream before SslStream authentication.</Description>
    <PackageId>StreamExtended</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/justcoding121/stream-extended</PackageProjectUrl>
    <RepositoryUrl>https://github.com/justcoding121/stream-extended</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>tls;sni;ssl;handshake;peek</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);CS1591;SYSLIB0039;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>StreamExtended.Tests, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
